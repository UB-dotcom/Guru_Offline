        "topic": "Real Numbers",
        "question": "If HCF(306, 657) = 9, what is LCM(306, 657)?",
        "options": [
          "A) 22338",
          "B) 22330",
          "C) 18450",
          "D) 25120"
        ],
        "correct": "A",
        "explanation": "LCM = (a * b) / HCF = (306 * 657) / 9 = 34 * 657 = 22,338."
      },
